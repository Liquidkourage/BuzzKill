// BuzzKill league schema — accounts, season weeks, scheduled matches

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  email          String           @unique
  name           String?
  passwordHash   String
  isCommissioner Boolean          @default(false)
  isReader       Boolean          @default(false)
  memberships    TeamMember[]
  rosterSpots    RosterPlayer[]
  readingMatches ScheduledMatch[] @relation("MatchReader")
}

model Season {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  name            String
  slug            String           @unique
  status          String           @default("open") // open | active | closed
  entryFeeCents   Int              @default(0)
  entryNote       String?
  blurb           String?
  registrations   Registration[]
  matches         Match[]
  weeks           SeasonWeek[]
  scheduledMatches ScheduledMatch[]
}

model Team {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  name             String
  slug             String?          @unique
  members          TeamMember[]
  homeMatches      Match[]          @relation("homeMatches")
  awayMatches      Match[]          @relation("awayMatches")
  registrations    Registration[]
  scheduledHome    ScheduledMatch[] @relation("schedHome")
  scheduledAway    ScheduledMatch[] @relation("schedAway")
}

model Registration {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  seasonId      String
  season        Season         @relation(fields: [seasonId], references: [id])
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id])
  captainName   String
  captainEmail  String
  captainPhone  String?
  rosterText    String         @default("")
  paymentStatus String         @default("pending") // pending | paid | waived
  wins          Int            @default(0)
  losses        Int            @default(0)
  ties          Int            @default(0)
  pointsFor     Int            @default(0)
  pointsAgainst Int            @default(0)
  roster        RosterPlayer[]

  @@unique([seasonId, teamId])
  @@index([seasonId])
}

/// Named player on a season registration (target: 5 per team).
model RosterPlayer {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  name           String
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  sortOrder      Int          @default(0)

  @@index([registrationId, sortOrder])
}

model TeamMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      String // captain | player
  userId    String
  teamId    String
  seasonId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

/// Calendar week for a season (Sunday start → Saturday end).
model SeasonWeek {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  seasonId  String
  season    Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  weekIndex Int
  startsOn  DateTime
  label     String?
  matches   ScheduledMatch[]

  @@unique([seasonId, weekIndex])
  @@index([seasonId])
}

/// Planned match inside a season week. Each team ≤ 1 match per week.
model ScheduledMatch {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  seasonId    String
  weekId      String
  teamAId     String
  teamBId     String
  readerId    String?
  status      String     @default("scheduled") // scheduled | confirmed | live | completed | canceled
  startsAt    DateTime?
  notes       String?
  liveMatchId String?    @unique
  season      Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  week        SeasonWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  teamA       Team       @relation("schedHome", fields: [teamAId], references: [id])
  teamB       Team       @relation("schedAway", fields: [teamBId], references: [id])
  reader      User?      @relation("MatchReader", fields: [readerId], references: [id])

  @@index([weekId])
  @@index([seasonId])
  @@index([readerId])
}

model Match {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  code         String       @unique
  status       String
  maxQuestions Int          @default(20)
  scoreA       Int          @default(0)
  scoreB       Int          @default(0)
  overtime     Boolean      @default(false)
  seasonId     String?
  season       Season?      @relation(fields: [seasonId], references: [id])
  packId       String?
  pack         GamePack?    @relation(fields: [packId], references: [id])
  teamAId      String
  teamBId      String
  teamA        Team         @relation("homeMatches", fields: [teamAId], references: [id])
  teamB        Team         @relation("awayMatches", fields: [teamBId], references: [id])
  events       MatchEvent[]

  @@index([packId])
}

model MatchEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String
  payload   Json
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
}

model GamePack {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String
  slug        String     @unique
  description String?
  status      String     @default("draft")
  questions   Question[]
  matches     Match[]
}

model Question {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  packId     String
  pack       GamePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  prompt     String
  answer     String
  category   String?
  difficulty String?
  notes      String?

  @@index([packId, sortOrder])
}
