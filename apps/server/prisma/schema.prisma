// BuzzKill league schema — organizer-run seasons, paid team entry, standings

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  email       String       @unique
  name        String?
  memberships TeamMember[]
}

model Season {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  name          String
  slug          String         @unique
  status        String         @default("open") // open | active | closed
  entryFeeCents Int            @default(0)
  entryNote     String?
  blurb         String?
  registrations Registration[]
  matches       Match[]
}

model Team {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  name          String
  slug          String?        @unique
  members       TeamMember[]
  homeMatches   Match[]        @relation("homeMatches")
  awayMatches   Match[]        @relation("awayMatches")
  registrations Registration[]
}

model Registration {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seasonId      String
  season        Season   @relation(fields: [seasonId], references: [id])
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id])
  captainName   String
  captainEmail  String
  captainPhone  String?
  rosterText    String
  paymentStatus String   @default("pending") // pending | paid | waived
  wins          Int      @default(0)
  losses        Int      @default(0)
  ties          Int      @default(0)
  pointsFor     Int      @default(0)
  pointsAgainst Int      @default(0)

  @@unique([seasonId, teamId])
  @@index([seasonId])
}

model TeamMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      String
  userId    String
  teamId    String
  user      User     @relation(fields: [userId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Match {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  code         String       @unique
  status       String
  maxQuestions Int          @default(20)
  scoreA       Int          @default(0)
  scoreB       Int          @default(0)
  overtime     Boolean      @default(false)
  seasonId     String?
  season       Season?      @relation(fields: [seasonId], references: [id])
  teamAId      String
  teamBId      String
  teamA        Team         @relation("homeMatches", fields: [teamAId], references: [id])
  teamB        Team         @relation("awayMatches", fields: [teamBId], references: [id])
  events       MatchEvent[]
  questions    Question[]
}

model MatchEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String
  payload   Json
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
}

model Question {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  prompt     String
  answer     String
  category   String?
  difficulty String?
  matchId    String?
  match      Match?   @relation(fields: [matchId], references: [id])
}
