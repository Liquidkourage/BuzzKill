# Copy values into Railway service variables (or use the dashboard).

# --- web service ---
# NEXT_PUBLIC_SERVER_URL=https://<your-server-service>.up.railway.app

# --- BuzzKill (server) service ---
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Add Railway Postgres plugin to the project for a durable database.
# Do not use file: SQLite on Railway without a volume — deploys wipe the disk.
